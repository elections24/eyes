rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function agentPath(uid) { return /databases/$(database)/documents/electionAgents/$(uid); }
    function hasAgent(uid) { return signedIn() && exists(agentPath(uid)); }
    function agentData(uid) { return get(agentPath(uid)).data; }
    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function isActiveAgent(uid, role) {
      return hasAgent(uid)
        && agentData(uid).status == 'active'
        && agentData(uid).agentRole == role;
    }
    function puAssignmentMatches(data) {
      return isActiveAgent(request.auth.uid, 'polling_unit_agent')
        && data.agentUid == request.auth.uid
        && data.agentRole == 'polling_unit_agent'
        && data.candidateId == agentData(request.auth.uid).candidateId
        && data.electionType == agentData(request.auth.uid).electionType
        && data.stateCode == agentData(request.auth.uid).geography.stateCode
        && data.lgaCode == agentData(request.auth.uid).geography.lgaCode
        && data.wardCode == agentData(request.auth.uid).geography.wardCode
        && data.pollingUnitCode == agentData(request.auth.uid).geography.pollingUnitCode;
    }
    function wardCanRead(data) {
      return isActiveAgent(request.auth.uid, 'ward_collation_agent')
        && data.candidateId == agentData(request.auth.uid).candidateId
        && data.electionType == agentData(request.auth.uid).electionType
        && data.stateCode == agentData(request.auth.uid).geography.stateCode
        && data.lgaCode == agentData(request.auth.uid).geography.lgaCode
        && data.wardCode == agentData(request.auth.uid).geography.wardCode;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }
    match /electionAgents/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }
    match /candidates/{id} { allow read, write: if isSuperAdmin(); }
    match /geographyStates/{id} { allow read, write: if isSuperAdmin(); }
    match /geographyLGAs/{id} { allow read, write: if isSuperAdmin(); }
    match /geographyWards/{id} { allow read, write: if isSuperAdmin(); }
    match /geographyPollingUnits/{id} { allow read, write: if isSuperAdmin(); }
    match /geographySenatorialZones/{id} { allow read, write: if isSuperAdmin(); }
    match /geographyFederalConstituencies/{id} { allow read, write: if isSuperAdmin(); }

    // Polling Unit submissions: agent creates only for their own exact assignment;
    // assigned Ward Agent can read child records for the same election/ward.
    match /ec8aResults/{id} {
      allow create: if puAssignmentMatches(request.resource.data);
      allow get, list: if isSuperAdmin() || (signedIn() && resource.data.agentUid == request.auth.uid) || wardCanRead(resource.data);
      allow update, delete: if isSuperAdmin();
    }
    match /evidenceUploads/{id} {
      allow create: if puAssignmentMatches(request.resource.data);
      allow get, list: if isSuperAdmin() || (signedIn() && resource.data.agentUid == request.auth.uid) || wardCanRead(resource.data);
      allow update, delete: if isSuperAdmin();
    }
    match /pollingUnitReports/{id} {
      allow create: if puAssignmentMatches(request.resource.data);
      allow get, list: if isSuperAdmin() || (signedIn() && resource.data.agentUid == request.auth.uid) || wardCanRead(resource.data);
      allow update, delete: if isSuperAdmin();
    }
    match /backupRequests/{id} {
      allow create: if puAssignmentMatches(request.resource.data);
      allow get, list: if isSuperAdmin() || (signedIn() && resource.data.agentUid == request.auth.uid);
      allow update, delete: if isSuperAdmin();
    }
    match /voteBuyingAlerts/{id} {
      allow create: if puAssignmentMatches(request.resource.data);
      allow get, list: if isSuperAdmin() || (signedIn() && resource.data.agentUid == request.auth.uid) || wardCanRead(resource.data);
      allow update, delete: if isSuperAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
